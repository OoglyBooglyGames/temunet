{
  "version": 2,
  "rewrites": [
    { "source": "/proxy/(.*)", "destination": "/api/proxy?url=$1" },
    { "source": "/js/concat(.*)", "destination": "/api/proxy?url=https://www.redditstatic.com/js/concat$1" },
    { "source": "/results(.*)", "destination": "/api/proxy?url=https://www.youtube.com/results$1" }
  ]
}